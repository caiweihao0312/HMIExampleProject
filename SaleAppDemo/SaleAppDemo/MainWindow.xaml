<Window x:Class="Sale.AppDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sale.AppDemo"
        mc:Ignorable="d"
        Title="商品管理" Height="350" Width="525">
    <Grid>
        <DataGrid x:Name="dgProducts" AutoGenerateColumns="True" Margin="10,10,10,50"/>
        <Button Content="添加" HorizontalAlignment="Left" Margin="10,270,0,0" VerticalAlignment="Top" Width="75" Click="BtnAdd_Click"/>
        <Button Content="删除" HorizontalAlignment="Left" Margin="100,270,0,0" VerticalAlignment="Top" Width="75" Click="BtnDelete_Click"/>
        <Button x:Name="btnCreateDb" HorizontalAlignment="Left" Margin="200,270,0,0" VerticalAlignment="Top" Width="75" Content="创建本地数据库" Click="btnCreateDb_Click" />
        <Button Content="加载数据库" HorizontalAlignment="Left" Margin="300,270,0,0" VerticalAlignment="Top" Width="75" Click="BtnLoadDb_Click"/>
    </Grid>
</Window>
